{
  "manifest_version": 3,
  "name": "Margin",
  "version": "2.3.2",
  "version_name": "2.3.2",
  "description": "Quiet editorial AI translation for web pages, input boxes, YouTube bilingual PiP, PDFs, and images.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Margin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "margin_static_rules",
        "enabled": true,
        "path": "rules/net-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "subtitles.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "image-translate.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.html",
        "pdf.worker.min.mjs",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggleTranslatePage": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Toggle bilingual translation on current page"
    },
    "toggleTranslateWholePage": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "Translate entire page immediately"
    },
    "toggleTranslationMask": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Toggle blur mask reveal on translated text"
    },
    "translateInputBox": {
      "suggested_key": {
        "default": "Alt+I"
      },
      "description": "Quick-translate active input box"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
